# Copia este archivo a .env y rellénalo. El .env NUNCA se sube al repo.

# --- App de Meta (solo hacen falta para setup_token.py) ------------------
META_APP_ID=
META_APP_SECRET=

# --- Cuenta de Instagram (los da setup_token.py) ------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Almacén de medios (cualquiera compatible con S3) -------------------
# Backblaze B2, región europea. La consola te da el endpoint al crear el
# bucket, y S3_PUBLIC_BASE es la "friendly URL" del bucket público.
#
# Cloudflare R2 también vale, pero en España los ISP tienen bloqueados sus
# rangos por las órdenes judiciales de LaLiga y no se llega al endpoint.
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ig-media
S3_PUBLIC_BASE=https://f003.backblazeb2.com/file/ig-media

# --- Preferencias -------------------------------------------------------
TZ_LOCAL=Europe/Madrid
